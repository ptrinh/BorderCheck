{
  "name": "Example Org",
  "report": {
    "url": "https://bordercheck.example.com/report",
    "headers": {
      "Authorization": "Bearer <report-submit-token>"
    },
    "interval": "24h",
    "check_interval": "",
    "include_evidence": false,
    "email_domains": [
      "example.com"
    ],
    "include_ips": false,
    "include_location": false,
    "fix_prompt": true,
    "compromise_alert": true
  },
  "update": {
    "binary": true,
    "policy_url": "https://bordercheck.example.com/policies.json",
    "interval": "24h",
    "repo": "ptrinh/bordercheck",
    "public_key": ""
  },
  "notify": {
    "enabled": true,
    "statuses": [
      "fail"
    ],
    "severities": [
      "high",
      "medium"
    ],
    "remind_every": "24h",
    "open_report": true
  },
  "waivers": [
    {
      "check": "listeners",
      "email": "dev@example.com",
      "hostname": "dev-mbp",
      "until": "2026-12-01",
      "reason": "Postgres on 5432 for the data migration; ticket IT-123"
    }
  ],
  "checks": {
    "firewall": {
      "require_stealth": true,
      "suggest_outbound": true
    },
    "disk-encryption": {},
    "listeners": {
      "allow": [
        {
          "process": "rapportd"
        },
        {
          "process": "ControlCenter",
          "port": "7000"
        }
      ],
      "info_only": [
        "ControlCenter",
        "DropboxFileProvider",
        "Dropbox",
        "Spotify",
        "tailscaled",
        "IPNExtension"
      ]
    },
    "mesh-vpn": {
      "allow": []
    },
    "docker": {
      "allow_containers": [],
      "allow_mounts": []
    },
    "secrets": {
      "extra_files": [],
      "ignore_paths": [
        "~/**/test-fixtures/**"
      ],
      "production_keywords": [
        "prod",
        "production",
        "live"
      ],
      "show_tail": true,
      "walk_depth": 5,
      "extra_patterns": [
        {
          "kind": "Example internal token",
          "regex": "\\bexo_[A-Za-z0-9]{32}\\b",
          "high": true,
          "show_tail": true
        }
      ],
      "locations": {
        "docker": true,
        "kube": true,
        "netrc": true,
        "git_credentials": true,
        "gcloud": true,
        "azure": true,
        "pypirc": true,
        "gh": true,
        "terraform": true,
        "pgpass": true,
        "mysql": true,
        "git_remotes": true,
        "ai_chats": true
      },
      "user_ignore": true,
      "sample_rules": ["git-tracked", "sdk", "sample-dir"],
      "ai_chat_hours": 48,
      "cli_sign_ins_info": true,
      "ai_chat_max_mb": 256
    },
    "ssh-keys": {
      "no_passphrase": true,
      "loose_permissions": true,
      "authorized_keys": true,
      "allow_keys": [],
      "client_config": true,
      "user_ignore": true
    },
    "tunnels": {
      "processes": true,
      "tailscale_funnel": true,
      "tailscale_serve": true,
      "allow": [],
      "lower_severity": [
        "cloudflared"
      ]
    },
    "os-updates": {
      "min_os_versions": {
        "macos": "15",
        "windows": "19045",
        "ubuntu": "22.04",
        "debian": "12",
        "fedora": "43"
      },
      "require_auto_update": true,
      "max_check_age_days": 14,
      "max_pending_days": 14,
      "max_days_since_update": 45,
      "check_browsers": true,
      "max_browser_age_days": 60,
      "min_browser_versions": {}
    },
    "screen-lock": {
      "require_password": true,
      "max_lock_minutes": 10
    },
    "remote-access": {
      "allow": [
        "guest"
      ],
      "third_party": true
    },
    "ai-agents": {
      "tokens": true,
      "guardrails": true,
      "extra_paths": [],
      "ignore_paths": [],
      "user_ignore": true
    },
    "cracked-software": {
      "suggest_alternatives": true
    },
    "admin-rights": {
      "allow_admin": true
    },
    "os-protections": {
      "sip": true,
      "gatekeeper": true,
      "antivirus": true,
      "smartscreen": true,
      "secure_boot": true,
      "lsm": true
    },
    "sharing": {
      "allow": []
    },
    "extensions": {
      "browsers": true,
      "editors": true,
      "block": [],
      "allow": [],
      "warn_all_sites": false,
      "allow_unpacked": []
    },
    "browser-passwords": {
      "allow_browsers": [],
      "pass_below": 10,
      "medium_above": 20
    },
    "trust-store": {
      "cas": true,
      "proxies": true,
      "allow_cas": [],
      "allow_proxies": [],
      "ca_severity": "medium"
    },
    "package-managers": {
      "tools": [
        "npm",
        "pnpm",
        "yarn",
        "bun",
        "pip",
        "uv",
        "go",
        "cargo"
      ],
      "require_ignore_scripts": true,
      "require_release_age": false,
      "allow_hosts": []
    },
    "startup-items": {
      "allow": [],
      "extra_suspicious_paths": []
    },
    "backup": {
      "require_backup": false,
      "require_encrypted": true,
      "require_find_my": true,
      "max_backup_age_days": 0
    }
  }
}
